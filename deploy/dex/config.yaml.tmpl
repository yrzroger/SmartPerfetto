# Dex configuration for a SmartPerfetto LAN deployment.
#
# Generated by scripts/deploy-lan.sh from deploy/dex/config.yaml.tmpl; every
# __PLACEHOLDER__ was substituted with a value detected or generated on this
# host. Edit the template, not this file.
#
# Login form asks for the account address only. Every account carries the bcrypt
# hash of the empty string, so anyone who can reach this page and knows a listed
# address is that person. Keep this deployment experimental and LAN-only.
issuer: __ISSUER__

# Accounts live only in memory: a restart empties staticPasswords, so re-add
# users with add-user.sh after one.
storage:
  type: memory

web:
  http: 0.0.0.0:5556

# Serve the email-only login form from web/templates/password.html.
frontend:
  dir: /web
  # Dex ships light and dark; a name without a matching themes/<name>/ makes the
  # theme stylesheet 404 and the page falls back to unstyled browser defaults.
  theme: light

oauth2:
  skipApprovalScreen: true
  # Show the login form directly instead of an IdP picker.
  passwordConnector: local

staticClients:
  - id: smartperfetto
    name: SmartPerfetto
    secret: __CLIENT_SECRET__
    redirectURIs:
      - __REDIRECT_URI__

enablePasswordDB: true

# hash is bcrypt("") for every account; add-user.sh appends entries here.
staticPasswords: []
